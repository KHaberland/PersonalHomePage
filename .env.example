# ===========================================
# Переменные окружения для всего проекта
# Скопируйте в .env и заполните значения
# НЕ коммитьте .env — только этот .env.example (без секретов)
# ===========================================

# ---------- Backend (Django) ----------
SECRET_KEY=your-django-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных
DATABASE_URL=postgresql://user:password@localhost:5432/personal_homepage_db

# CORS (URL фронтенда)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media storage (опционально: AWS S3 или Cloudinary)
# AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_CUSTOM_DOMAIN=  # опционально
# AWS_S3_ENDPOINT_URL=   # для S3-совместимых (R2, DigitalOcean)
# Cloudinary: pip install django-cloudinary-storage, затем CLOUDINARY_URL=cloudinary://...

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Базовый URL сайта для SEO (sitemap, Open Graph, canonical). В production: https://yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ---------- Brevo (рассылка, backend only) ----------
# BREVO_API_KEY=
# BREVO_LIST_ID_BLOG=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=
# BREVO_DOI_TEMPLATE_ID=
# BREVO_DOI_REDIRECT_URL=http://localhost:3000/{locale}/blog?newsletter=confirmed
# BREVO_NOTIFY_EMAIL=you@example.com
# BREVO_TEMPLATE_QUESTION_NOTIFY=
# BREVO_TEMPLATE_INQUIRY_NOTIFY=
# BREVO_WEBHOOK_SECRET=  # секрет для POST /api/leads/brevo/webhook/ (?secret= или X-Webhook-Secret)
# BREVO_TEMPLATE_NEWSLETTER_ARTICLE=  # опционально: ID шаблона кампании «новая статья»
# BREVO_NEWSLETTER_LOCALE_SEGMENTS=ru:12,en:34,lv:56  # сегменты Brevo по языку (опционально)
# BREVO_AUTO_SEND_ON_PUBLISH=False  # авто-рассылка при сохранении published-поста
# В Brevo: Marketing → Webhooks → list_addition + unsubscribe → URL webhook

# Лимит POST /api/leads/* по IP (формат DRF: 10/hour, 5/minute)
# LEADS_RATE_LIMIT=10/hour

# Hero-видео (опционально). WebM — сжатый формат для лучшей производительности
# NEXT_PUBLIC_HERO_VIDEO_URL=https://...
# NEXT_PUBLIC_HERO_VIDEO_WEBM=https://...
# NEXT_PUBLIC_HERO_VIDEO_POSTER=https://...
# Затемнение поверх hero-видео, 0–1 (после изменения — перезапуск dev-сервера)
# NEXT_PUBLIC_HERO_OVERLAY_OPACITY=0.55
